REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis Sharding Configuration
REDIS_SHARD_CONNECTION=default
REDIS_SHARD_STRATEGY=consistent_hashing
REDIS_SHARD_AUTO_PROVISION=false
REDIS_SHARD_MAX_SHARDS=10
REDIS_SHARD_PROVISION_THRESHOLD=1000000
REDIS_SHARD_CACHE_TTL=3600

# Shard 1 Database Configuration
DB_SHARD_1_HOST=127.0.0.1
DB_SHARD_1_PORT=3306
DB_SHARD_1_DATABASE=shard_1
DB_SHARD_1_USERNAME=root
DB_SHARD_1_PASSWORD=

# Shard 2 Database Configuration
DB_SHARD_2_HOST=127.0.0.1
DB_SHARD_2_PORT=3306
DB_SHARD_2_DATABASE=shard_2
DB_SHARD_2_USERNAME=root
DB_SHARD_2_PASSWORD=

# Shard 3 Database Configuration (optional)
DB_SHARD_3_HOST=127.0.0.1
DB_SHARD_3_PORT=3306
DB_SHARD_3_DATABASE=shard_3
DB_SHARD_3_USERNAME=root
DB_SHARD_3_PASSWORD=
