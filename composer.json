{
    "name": "yusuf.kef/laravel-redis-shard",
    "description": "A comprehensive Redis-based database sharding solution for Laravel with automatic data distribution and intelligent routing",
    "keywords": ["laravel", "redis", "sharding", "database", "scaling", "distributed", "multi-tenant"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yusuf KEF",
            "email": "kefyusuf@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0|^2.0",
        "predis/predis": "^2.0",
        "illuminate/redis": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "predis/predis": "Required when the redis module is enabled (persistent shard map)",
        "illuminate/redis": "Required when the redis module is enabled (persistent shard map)",
        "illuminate/queue": "Required when the queue module is enabled (shard-aware jobs)"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\RedisShard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\RedisShard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint-fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravel\\RedisShard\\RedisShardServiceProvider"
            ],
            "aliases": {
                "ShardManager": "Laravel\\RedisShard\\Facades\\ShardManager"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
