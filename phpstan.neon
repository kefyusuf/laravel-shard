parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Console/Commands/*
        # Optional Laravel Health adapter; framework health classes are not
        # always present in package installs.
        - src/Metrics/LaravelShardHealthCheck.php
    ignoreErrors:
        # Traits are public API for consumer models; they are not referenced inside src.
        -
            message: '#Trait Laravel\\RedisShard\\.* is used zero times and is not analysed#'
            reportUnmatched: false
    tmpDir: build/phpstan
    parallel:
        maximumNumberOfProcesses: 1
